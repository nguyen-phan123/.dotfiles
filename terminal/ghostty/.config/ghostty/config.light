# Ghostty Light Mode Config - Optimized for nearsighted users in bright office lighting
# Font configuration
font-family = "JetBrains Mono"
font-size = 16

# Theme - High contrast for better readability
theme = "GitHub Light High Contrast"

# Layout optimization
window-padding-x = 8
window-padding-y = 8

# Reduce glare on glossy screens
background-opacity = 0.95

# Cursor - Easy to track
cursor-style = block
cursor-style-blink = true

# macOS settings (preserved from original config)
macos-non-native-fullscreen = true
macos-titlebar-style = transparent
window-save-state = never
macos-auto-secure-input = true
macos-secure-input-indication = true
